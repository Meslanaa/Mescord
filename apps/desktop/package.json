{
  "name": "@mescord/desktop",
  "version": "0.1.1",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "dev": "wait-on http://localhost:5173 && cross-env MESCORD_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:desktop": "wait-on http://localhost:5174 && cross-env MESCORD_DEV_SERVER_URL=http://localhost:5174 electron .",
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "publish": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "cross-env": "^7.0.3",
    "electron": "31.7.7",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.mescord.desktop",
    "productName": "Mescord",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Meslanaa",
        "repo": "Mescord",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mescord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
